# Copy to .env on the server (never commit .env). docker compose reads it from the project root.
# MySQL root password (admin work only; the app never sees it), e.g. openssl rand -hex 24
DB_ROOT_PASSWORD=
# Password of the dhotels_app database user the app signs in with, e.g. openssl rand -hex 24
SPRING_DATASOURCE_PASSWORD=
# Login token signing key, at least 32 characters, e.g. openssl rand -hex 32
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SPRING_MAIL_HOST=smtp.hostinger.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=d@dhotels24.com
SPRING_MAIL_PASSWORD=
NOTIFICATION_EMAIL=d@dhotels24.com
SITE_URL=https://dhotels24.in
SEED_SAMPLE_USER=false
# First admin account, created on startup if it doesn't exist (password: 12+ characters)
ADMIN_EMAIL=d@dhotels24.com
ADMIN_INITIAL_PASSWORD=
ADMIN_MOBILE=8655811111
# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=https://dhotels24.in
